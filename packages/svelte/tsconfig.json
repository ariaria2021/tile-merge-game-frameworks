{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "paths": {
            "@game-frameworks/shared/*": [
                "../shared/src/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.svelte"
    ]
}